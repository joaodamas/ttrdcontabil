rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function clienteDoc(clienteId) {
      return firestore.get(/databases/(default)/documents/clientes/$(clienteId)).data;
    }

    function userExists() {
      return isAuth() && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function userHasTenant() {
      return userExists()
        && ('tenantId' in userDoc())
        && (userDoc().tenantId is string)
        && userDoc().tenantId.size() > 0;
    }

    function isAtivo() {
      return userHasTenant()
        && (!('ativo' in userDoc()) || userDoc().ativo == true);
    }

    function canReadCliente(clienteId) {
      return isAtivo()
        && firestore.exists(/databases/(default)/documents/clientes/$(clienteId))
        && ('tenantId' in clienteDoc(clienteId))
        && userDoc().tenantId == clienteDoc(clienteId).tenantId;
    }

    // Espelha canReadNfse() de firestore.rules: perfil fiscal/financeiro/admin
    // ou a tela 'fiscal' concedida ao usuário.
    function canReadNfse() {
      return isAtivo()
        && (userDoc().perfil in ['admin', 'fiscal', 'financeiro']
          || (('telas' in userDoc()) && (userDoc().telas is list) && ('fiscal' in userDoc().telas)));
    }

    // Documentos de clientes: nenhuma tela grava ou lê este caminho
    // (conferido em 2026-11-06). Trancado até existir uma tela — e então
    // restringir por perfil como o nfse/ abaixo, não por "lê o cliente".
    match /documentos/{clienteId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Certificados digitais — acesso restrito (Admin SDK only)
    match /certificados/{clienteId}/{allPaths=**} {
      allow read, write: if false;
    }

    // NFS-e (XML/PDF) — exige path com clienteId: nfse/{clienteId}/...
    // Antes bastava ler o cliente: o perfil "leitura" baixava o DANFSe de notas
    // que firestore.rules não o deixa ver.
    match /nfse/{clienteId}/{allPaths=**} {
      allow read: if canReadCliente(clienteId) && canReadNfse();
      allow write: if false;
    }

    // Bloqueia tudo mais
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
