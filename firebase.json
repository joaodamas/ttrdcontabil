{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "site": "ttrdcontabil-jpproject",
    "public": "out",
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR\" run build"
    ],
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/clientes/*/tomadores/importar",
        "destination": "/clientes/placeholder/tomadores/importar.html"
      },
      {
        "source": "/clientes/*/tomadores",
        "destination": "/clientes/placeholder/tomadores.html"
      },
      {
        "source": "/clientes/*/servicos/novo",
        "destination": "/clientes/placeholder/servicos/novo.html"
      },
      {
        "source": "/clientes/*/editar",
        "destination": "/clientes/placeholder/editar.html"
      },
      {
        "source": "/clientes/*/fiscal",
        "destination": "/clientes/placeholder/fiscal.html"
      },
      {
        "source": "/clientes/*",
        "destination": "/clientes/placeholder.html"
      },
      {
        "source": "/competencias/*/editar",
        "destination": "/competencias/placeholder/editar.html"
      },
      {
        "source": "/competencias/*",
        "destination": "/competencias/placeholder.html"
      },
      {
        "source": "/fiscal/*",
        "destination": "/fiscal/placeholder.html"
      },
      {
        "source": "/ir/*/editar",
        "destination": "/ir/placeholder/editar.html"
      },
      {
        "source": "/ir/*",
        "destination": "/ir/placeholder.html"
      },
      {
        "source": "/tarefas/*/editar",
        "destination": "/tarefas/placeholder/editar.html"
      },
      {
        "source": "/tarefas/*",
        "destination": "/tarefas/placeholder.html"
      },
      {
        "source": "**",
        "destination": "/dashboard.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://southamerica-east1-ttrdcontabil-jpproject.cloudfunctions.net https://brasilapi.com.br https://viacep.com.br; frame-src https://ttrdcontabil-jpproject.firebaseapp.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5050
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
