{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "hosting": {
    "site": "ttrdcontabil-jpproject",
    "public": "out",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/clientes/*/servicos/novo", "destination": "/clientes/placeholder/servicos/novo.html" },
      { "source": "/clientes/*/editar",        "destination": "/clientes/placeholder/editar.html" },
      { "source": "/clientes/*/fiscal",        "destination": "/clientes/placeholder/fiscal.html" },
      { "source": "/clientes/*",               "destination": "/clientes/placeholder.html" },
      { "source": "/competencias/*/editar",    "destination": "/competencias/placeholder/editar.html" },
      { "source": "/competencias/*",           "destination": "/competencias/placeholder.html" },
      { "source": "/ir/*/editar",              "destination": "/ir/placeholder/editar.html" },
      { "source": "/ir/*",                     "destination": "/ir/placeholder.html" },
      { "source": "/tarefas/*/editar",         "destination": "/tarefas/placeholder/editar.html" },
      { "source": "/tarefas/*",                "destination": "/tarefas/placeholder.html" },
      { "source": "**",                        "destination": "/dashboard.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}

