# Variáveis de ambiente das Cloud Functions — TTRD Contábil
# Copie para `.env` (ou configure no ambiente de deploy). NÃO commitar segredos.

# ─── WhatsApp via Twilio ───────────────────────────────────────────────────────
# Conta Twilio com um WhatsApp Sender aprovado (a aprovação de templates ainda
# passa pela Meta por trás — a Twilio é uma BSP, não elimina esse passo).
# São secret (defineSecret, functions/src/whatsapp/secrets.ts) — configure com:
#   firebase functions:secrets:set TWILIO_ACCOUNT_SID
#   firebase functions:secrets:set TWILIO_AUTH_TOKEN

# Account SID da conta Twilio (Console > Account Info).
TWILIO_ACCOUNT_SID=

# Auth Token da conta Twilio. Também usado para validar a assinatura
# X-Twilio-Signature dos POSTs do webhook. ENQUANTO VAZIO, o webhook rejeita
# todo POST (fail-closed).
TWILIO_AUTH_TOKEN=

# O número do WhatsApp Sender (ex.: +5511999999999) NÃO é secret — fica em
# `configuracoes/escritorio` no Firestore, editável na tela Admin > Parâmetros
# (campo "Número Twilio (WhatsApp)").

# ─── Credenciais / NFS-e ──────────────────────────────────────────────────────
# Chave de criptografia (AES-256-GCM) das credenciais/certificados. Via Secret Manager.
# CREDENTIAL_KEY é declarado como secret (defineSecret) — configure com:
#   firebase functions:secrets:set CREDENTIAL_KEY

# ─── E-mail (alertas diários, backup) ─────────────────────────────────────────
# Usuário e senha são secret (defineSecret, functions/src/email/secrets.ts) — configure com:
#   firebase functions:secrets:set SMTP_USER
#   firebase functions:secrets:set SMTP_PASS
# (se for Gmail, SMTP_PASS precisa ser uma "senha de app", não a senha normal da conta)
#
# Host/porta/remetente/destinatário NÃO são secret — vão direto neste .env
# (copie pra functions/.env, que é lido no deploy; não precisa de comando extra):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM="TTRD Contábil <seuemail@gmail.com>"
EMAIL_TO=seuemail@gmail.com
