# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log
firestore-debug.log

# env files (can opt-in for committing if needed)
.env*
!.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads locais
/uploads
/.tools

# certificados
*.pfx
*.p12

# dados exportados de clientes (PII — não versionar; geráveis pelos scripts de export)
scripts/clientes-*.csv
scripts/clientes-*.json

# artefatos de falha do Playwright (screenshots, contexto de erro, .last-run.json)
# Reproduzíveis rodando a suíte, e o nome da pasta carrega o título do teste —
# viram lixo permanente no histórico a cada falha.
/test-results
/playwright-report
/blob-report

# cache do Firebase CLI. O hosting.*.cache é regravado a cada deploy e aparecia
# modificado em TODO diff, escondendo mudança de verdade no meio do ruído.
.firebase/
