rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ───────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function userExists() {
      return isAuth() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userHasTenant() {
      return userExists()
        && ('tenantId' in userDoc())
        && (userDoc().tenantId is string)
        && userDoc().tenantId.size() > 0;
    }

    // Usuário existe no sistema, está ativo e pertence ao ambiente atual.
    function isAtivo() {
      return userHasTenant()
        && (!('ativo' in userDoc()) || userDoc().ativo == true);
    }

    // Helpers de perfil — hierarquia: admin > operacional/fiscal/financeiro > leitura
    function isAdmin()       { return isAtivo() && userDoc().perfil == 'admin'; }
    function isOperacional() { return isAtivo() && userDoc().perfil in ['admin', 'operacional']; }
    function isFiscal()      { return isAtivo() && userDoc().perfil in ['admin', 'fiscal']; }
    function isFinanceiro()  { return isAtivo() && userDoc().perfil in ['admin', 'financeiro']; }
    // Quem toca a rotina contábil: o fiscal também cria/conclui tarefas, edita
    // competências, IR e células do fechamento — PERFIL_DEFAULT_TELAS dá essas
    // telas a ele, e sem isto ele as via mas tomava permission-denied ao salvar.
    // Exclusões continuam com isOperacional()/isAdmin().
    function isEquipeContabil() { return isAtivo() && userDoc().perfil in ['admin', 'operacional', 'fiscal']; }
    function canRead()       { return isAtivo(); }

    // Senhas de portal dos clientes (clientes_credenciais): só administrador e
    // fiscal, por PERFIL — conferido nos callables (PERFIS_CREDENCIAIS em
    // functions/src/usuarios/perfis.ts); as regras negam o navegador.

    // Campos que saíram de `clientes` para `clientes_credenciais/{clienteId}`.
    // Espelha CAMPOS_CREDENCIAL em src/lib/clientes-import.ts.
    function camposCredencialCliente() {
      return ['loginPrefeitura', 'senhaWebPrefeitura', 'senhaPinCertificadoDigitalECnpj',
        'loginPostoFiscal', 'senhaPostoFiscal', 'responsavelSenhaMeuGov', 'responsavelSenhaEcacPf',
        'responsavelSenhaWebPrefeitura', 'responsavelSenhaPinCertificadoDigitalCpf'];
    }

    // [P1] Espelha canAccessTela() (src/lib/permissions.ts): quando o admin concede
    // um array `telas` não vazio a um usuário via usuario-form, esse array vira a
    // fonte de verdade e PODE incluir telas fora do default do perfil. Sem este
    // helper, um usuário com a tela concedida via override veria o link na UI mas
    // levaria permission-denied no Firestore (regressão de lockout).
    function hasTela(tela) {
      return isAtivo()
        && ('telas' in userDoc())
        && (userDoc().telas is list)
        && (userDoc().telas.size() > 0)
        && (tela in userDoc().telas);
    }

    // [P0-1/P1] Leitura de coleções sensíveis: perfil-padrão OU override por tela
    // (hasTela), nunca mais restritivo que o que a UI já permite hoje.
    // nfse_*: PERFIL_DEFAULT_TELAS libera a tela 'fiscal' tanto para 'fiscal' quanto
    // para 'financeiro' (financeiro concilia emissão de NFS-e com cobrança).
    function canReadNfse()         { return isFiscal() || isFinanceiro() || hasTela('fiscal'); }
    // clientes_fiscal / produtos: mesma tela 'fiscal', mas SEM o perfil
    // 'financeiro' (financeiro não configura integração fiscal do cliente).
    // [M1, 2026-11-06] Antes era isFiscal() || hasTela('fiscal'): como
    // PERFIL_DEFAULT_TELAS dá a tela 'fiscal' ao financeiro e o formulário de
    // usuários grava esse array, todo financeiro lia clientes_fiscal — inclusive
    // o bloco `credenciais` (senha do A1 cifrada, caminho do .pfx). O override
    // de tela continua valendo para operacional/leitura com 'fiscal' concedida.
    function canReadFiscalConfig() {
      return isFiscal() || (hasTela('fiscal') && userDoc().perfil != 'financeiro');
    }
    function canReadIr()           { return isFiscal() || hasTela('ir'); }
    function canReadFinanceiro()   { return isFinanceiro() || hasTela('financeiro'); }
    function canReadFechamento()   { return isOperacional() || isFiscal() || hasTela('fechamento'); }

    // [P0-B] Quem produz conteúdo no Cliente 360 (POP, notas internas e
    // comentários da timeline). Não dá para usar isOperacional() aqui: o POP tem
    // uma seção Fiscal e uma Financeiro, e quem preenche cada uma é justamente o
    // perfil correspondente — 'fiscal' ficaria trancado fora do próprio campo.
    // Fica de fora só 'leitura', que enxerga a tela 'clientes' mas não escreve.
    function podeColaborarCliente() { return isOperacional() || isFiscal() || isFinanceiro(); }

    // [P0-B] Relatório de produtividade cruza o tempo de TODO mundo, então a
    // leitura de tarefas_timers segue a tela em que ele está pendurado ('admin',
    // ver app-sidebar.tsx), não o perfil de quem cronometra.
    function canReadProdutividade() { return isAdmin() || hasTela('admin'); }

    // [P1] Update de fechamento_revisoes que REABRE o mês (seta travado explicitamente
    // para false) exige admin. Ausência do campo `travado` no payload (não deveria
    // ocorrer — salvarRevisao sempre grava travado:true/false) NÃO é tratada como
    // reabertura, para nunca bloquear updates normais por acidente.
    function revisaoReabrindo() {
      return ('travado' in request.resource.data) && request.resource.data.travado == false;
    }

    function sameTenantExisting() {
      return isAtivo()
        && ('tenantId' in resource.data)
        && resource.data.tenantId == userDoc().tenantId;
    }

    function sameTenantNew() {
      return isAtivo()
        && ('tenantId' in request.resource.data)
        && request.resource.data.tenantId == userDoc().tenantId;
    }

    function sameTenantWrite() {
      return sameTenantNew();
    }

    function sameTenantUpdate() {
      return sameTenantExisting() && sameTenantNew();
    }

    // [P1] Enforcement server-side da trava mensal de fechamento. Espelha o check
    // client-side em updateFechamentoField (src/features/fechamento/services.ts):
    // reconstrói o id de fechamento_revisoes a partir de ano/mes do próprio doc
    // (mesmo formato usado por salvarRevisao: `${ano}_${String(mes).padStart(2,'0')}`)
    // e nega update se a revisão do mês estiver travada. Só avalia quando ano/mes
    // existem no doc (sempre presentes — únicos gravados por gerarFechamentoMensal,
    // Cloud Function) para nunca travar por doc malformado.
    function mesFechamentoTravadoImpl(ano, mes) {
      let revisaoId = string(ano) + '_' + (mes < 10 ? '0' + string(mes) : string(mes));
      return exists(/databases/$(database)/documents/fechamento_revisoes/$(revisaoId))
        && get(/databases/$(database)/documents/fechamento_revisoes/$(revisaoId)).data.tenantId == userDoc().tenantId
        && get(/databases/$(database)/documents/fechamento_revisoes/$(revisaoId)).data.travado == true;
    }

    function mesFechamentoTravado() {
      return ('ano' in resource.data) && ('mes' in resource.data)
        && mesFechamentoTravadoImpl(resource.data.ano, resource.data.mes);
    }

    // ─── Validadores de payload ───────────────────────────────────────────────

    function clienteStatusValido(status) {
      return status in ['ativo', 'inativo', 'suspenso'];
    }

    function prioridadeTarefaValida(prioridade) {
      return prioridade in ['baixa', 'normal', 'alta', 'urgente'];
    }

    function statusTarefaValido(status) {
      return status in ['pendente', 'em_andamento', 'concluida', 'cancelada'];
    }

    function statusCompetenciaValido(status) {
      return status in ['aberta', 'em_andamento', 'concluida', 'cancelada'];
    }

    // [MATRIZ DE TRANSIÇÃO] Espelha src/lib/status-transitions.ts — mantenha as
    // duas implementações em sincronia. Reabrir uma competência concluída ou
    // ressuscitar uma cancelada exige admin; nunca é permitido ir direto de
    // 'cancelada' para 'concluida' (precisa reabrir primeiro). Doc sem
    // 'status' anterior (dado legado) não é bloqueado por esta regra — apenas
    // a validação de payload acima já exige o campo em toda escrita nova.
    function competenciaTransicaoPermitida() {
      return !('status' in resource.data)
        || resource.data.status == request.resource.data.status
        || !(resource.data.status in ['concluida', 'cancelada'])
        || (resource.data.status == 'concluida' && isAdmin())
        || (resource.data.status == 'cancelada' && isAdmin() && request.resource.data.status != 'concluida');
    }

    // [MATRIZ DE TRANSIÇÃO] Idem para tarefas, mas reabrir/ressuscitar também é
    // permitido para o responsável atual pela tarefa (não só admin) — tarefas
    // são mais operacionais que competências fiscais.
    function tarefaResponsavelAtual() {
      return ('responsavelId' in resource.data) && resource.data.responsavelId == request.auth.uid;
    }

    function tarefaTransicaoPermitida() {
      return !('status' in resource.data)
        || resource.data.status == request.resource.data.status
        || !(resource.data.status in ['concluida', 'cancelada'])
        || (resource.data.status == 'concluida' && (isAdmin() || tarefaResponsavelAtual()))
        || (resource.data.status == 'cancelada' && (isAdmin() || tarefaResponsavelAtual())
            && request.resource.data.status != 'concluida');
    }

    function clientePayloadValido() {
      return ('status' in request.resource.data)
        && clienteStatusValido(request.resource.data.status)
        && ('razaoSocial' in request.resource.data)
        && (request.resource.data.razaoSocial is string)
        && (request.resource.data.razaoSocial.size() > 0)
        && (request.resource.data.razaoSocial.size() <= 200);
    }

    // [MELHORIA 1] Payload de tarefas agora exige campo 'titulo' — bloqueia
    // criação de tarefas sem título diretamente via API/SDK.
    function tarefaPayloadValido() {
      return ('titulo' in request.resource.data)
        && (request.resource.data.titulo is string)
        && (request.resource.data.titulo.size() > 0)
        && (request.resource.data.titulo.size() <= 500)
        && ('prioridade' in request.resource.data)
        && prioridadeTarefaValida(request.resource.data.prioridade)
        && ('status' in request.resource.data)
        && statusTarefaValido(request.resource.data.status);
    }

    // [MATRIZ DE TRANSIÇÃO] Exige 'status' válido em toda escrita de
    // competência — pré-requisito para competenciaTransicaoPermitida() acima
    // conseguir avaliar o campo com segurança.
    function competenciaPayloadValido() {
      return ('status' in request.resource.data)
        && statusCompetenciaValido(request.resource.data.status);
    }

    // [P0-A] Campos de clientes_fiscal que SÓ a Cloud Function pode gravar (o
    // Admin SDK ignora estas regras, então lá continuam graváveis). `credenciais`
    // guarda a chave de API da Spedy, o caminho do .pfx no Storage e a senha do
    // certificado A1; `spedyCompanyId` decide para qual empresa da Spedy o
    // enviarCertificadoSpedy manda esse .pfx.
    // A armadilha: `allow update: if isFiscal() && sameTenantUpdate()` não olhava
    // campo nenhum, então um perfil 'fiscal' apontava spedyCompanyId para uma
    // empresa dele, gravava a própria spedyApiKey via salvarCredenciaisFiscais e
    // recebia o certificado A1 do cliente na conta dele — A1 vazado emite nota
    // fiscal em nome da empresa da vítima. O formulário
    // (config-fiscal-form.tsx) nunca grava nenhum destes campos: as credenciais
    // sobem cifradas pela callable salvarCredenciaisFiscais.
    // `producaoLiberada` é a trava que separa homologação de nota real: se o
    // fiscal pudesse ligá-la, a liberação por município não valeria nada. Nenhuma
    // tela grava este campo — a liberação é feita pelo console/Admin SDK.
    function camposFiscalDoServidor() {
      return ['credenciais', 'spedyCompanyId', 'spedyProvisionadoEm', 'spedyCertificadoEnviadoEm', 'producaoLiberada'];
    }

    // Armadilha: no create não existe resource.data para o diff() comparar. Se só
    // o update fosse protegido, bastava CRIAR um segundo clientes_fiscal para o
    // mesmo clienteId já com spedyCompanyId e credenciais forjados — as functions
    // buscam a config por `where('clienteId','==',...).limit(1)`.
    function fiscalCreateSemCampoDeServidor() {
      return !request.resource.data.keys().hasAny(camposFiscalDoServidor());
    }

    function fiscalUpdateSemCampoDeServidor() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(camposFiscalDoServidor());
    }

    // [PRESTADOR→TOMADOR] O par (clienteId, cpfCnpj) é o que identifica um
    // tomador na carteira do prestador. Sem `clienteId` a carteira vira global e
    // o contrato recorrente fatura o tomador de outro cliente; sem `cpfCnpj`
    // não existe nota em prefeitura nenhuma. `ativo` é exigido porque a tela e o
    // gerador filtram por ele — tomador sem o campo é tomador invisível.
    // O formato de cpfCnpj é conferido aqui de propósito: TODO conector faz
    // replace(/\D/g,'') antes de enviar, então guardar "12.345.678/0001-90"
    // quebra dedup e comparação em silêncio, sem quebrar a emissão.
    function tomadorPayloadValido() {
      return ('clienteId' in request.resource.data)
        && (request.resource.data.clienteId is string)
        && (request.resource.data.clienteId.size() > 0)
        && ('cpfCnpj' in request.resource.data)
        && (request.resource.data.cpfCnpj is string)
        && request.resource.data.cpfCnpj.matches('^[0-9]{11}$|^[0-9]{14}$')
        && ('razaoSocial' in request.resource.data)
        && (request.resource.data.razaoSocial is string)
        && (request.resource.data.razaoSocial.size() > 0)
        && (request.resource.data.razaoSocial.size() <= 200)
        && ('ativo' in request.resource.data)
        && (request.resource.data.ativo is bool);
    }

    // [PRESTADOR→TOMADOR] O contrato precisa dizer, no mínimo, QUEM fatura QUEM,
    // de quanto e em que dia — contrato sem tomadorId reabre exatamente o buraco
    // que fazia a nota sair com prestador == tomador. `valor` numérico e > 0
    // porque valor zero/negativo vira nota inválida na prefeitura e string
    // "1.234,56" quebra o cálculo do ISS sem erro nenhum. `ativo` ausente faz o
    // cron (where ativo == true) simplesmente nunca faturar o contrato — falha
    // silenciosa que só aparece quando o cliente reclama da nota que não saiu.
    function nfseRecorrentePayloadValido() {
      return ('clienteId' in request.resource.data)
        && (request.resource.data.clienteId is string)
        && (request.resource.data.clienteId.size() > 0)
        && ('tomadorId' in request.resource.data)
        && (request.resource.data.tomadorId is string)
        && (request.resource.data.tomadorId.size() > 0)
        && ('descricao' in request.resource.data)
        && (request.resource.data.descricao is string)
        && (request.resource.data.descricao.size() > 0)
        && (request.resource.data.descricao.size() <= 2000)
        && ('valor' in request.resource.data)
        && (request.resource.data.valor is number)
        && (request.resource.data.valor > 0)
        && ('diaEmissao' in request.resource.data)
        && (request.resource.data.diaEmissao is int)
        && (request.resource.data.diaEmissao >= 1)
        && (request.resource.data.diaEmissao <= 31)
        && ('ativo' in request.resource.data)
        && (request.resource.data.ativo is bool);
    }

    // [PRESTADOR→TOMADOR] O contrato só aponta para tomador da carteira DO
    // PRÓPRIO prestador. Sem isto o cliente A fatura o tomador do cliente B — e
    // a carteira de B, que é a lista de clientes dele, vaza para dentro das
    // notas de A.
    // Tolerante a tomadorId inexistente de propósito: quem não existe não é de
    // ninguém, e travar aqui quebraria qualquer fluxo que grave o contrato antes
    // do tomador. O abuso real é apontar para um tomador que EXISTE e é de
    // outro prestador. Só é avaliada depois de nfseRecorrentePayloadValido()
    // (o && curto-circuita), que garante tomadorId string não vazia — path
    // montado com campo ausente quebraria a regra inteira.
    function tomadorDaCarteiraDoPrestador() {
      let tomadorPath = /databases/$(database)/documents/tomadores/$(request.resource.data.tomadorId);
      return !exists(tomadorPath)
        || get(tomadorPath).data.clienteId == request.resource.data.clienteId;
    }

    // ─── Usuários ─────────────────────────────────────────────────────────────

    // Criar, excluir e mudar perfil/telas/ativo/e-mail/tenant de usuário é só
    // pelas Cloud Functions (functions/src/usuarios/callables.ts), que exigem
    // admin ativo, validam perfil e telas, mantêm o Auth em sincronia (login
    // desabilitado ao desativar), travam o último admin e gravam auditoria.
    // O navegador só lê e, do próprio doc, atualiza nome e ultimoAcesso.
    match /usuarios/{uid} {
      allow get: if (isAuth() && request.auth.uid == uid) || (isAdmin() && sameTenantExisting());
      // Listar expõe e-mail, perfil e telas de todos: só admin (tela de
      // Usuários). Os seletores de responsável leem usuarios_diretorio.
      // Isolamento de tenant no `list`: ver a nota em usuarios_diretorio.
      allow list: if isAdmin();
      allow update: if isAuth() && request.auth.uid == uid && isAtivo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'ultimoAcesso'])
        && (!('nome' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.nome is string
            && request.resource.data.nome.size() >= 2
            && request.resource.data.nome.size() <= 100))
        && (!('ultimoAcesso' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.ultimoAcesso == request.time);
      allow create, delete: if false;
    }

    // Projeção id/nome/ativo de cada usuário, mantida pelo trigger
    // sincronizarDiretorioUsuario. É o que os seletores de responsável listam.
    // NOTA DE ISOLAMENTO: está em TENANT_SCOPED_COLLECTIONS
    // (src/lib/firestore-client.ts), então a query sai com
    // where('tenantId','==',...) e o `read` abaixo é avaliado por documento.
    match /usuarios_diretorio/{uid} {
      allow read: if canRead() && sameTenantExisting();
      allow write: if false;
    }

    // ─── Clientes ─────────────────────────────────────────────────────────────

    // Senhas de portal não entram mais em `clientes` (legível por qualquer
    // usuário ativo): vivem em clientes_credenciais. Docs antigos ainda podem
    // ter os campos até rodar scripts/migrar-credenciais-clientes.mjs — o update
    // pode REMOVÊ-los (a tela faz isso ao salvar), nunca gravar ou trocar.
    // `credenciaisPreenchidas` (lista de nomes de campo, sem valor) é escrita só
    // pelo trigger sincronizarCredenciaisPreenchidas.
    function clienteSemCredenciais() {
      return !request.resource.data.keys().hasAny(camposCredencialCliente().concat(['credenciaisPreenchidas']));
    }
    function clienteCredenciaisIntactas() {
      let diff = request.resource.data.diff(resource.data);
      let protegidos = camposCredencialCliente().concat(['credenciaisPreenchidas']);
      return !diff.addedKeys().hasAny(protegidos) && !diff.changedKeys().hasAny(protegidos)
        && !diff.removedKeys().hasAny(['credenciaisPreenchidas']);
    }

    match /clientes/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && clientePayloadValido() && sameTenantWrite() && clienteSemCredenciais();
      allow update: if isOperacional() && clientePayloadValido() && sameTenantUpdate() && clienteCredenciaisIntactas();
      // [MELHORIA 2] Delete separado: apenas admin pode remover clientes.
      // isOperacional inclui admin, mas tornar explícito evita que um
      // 'operacional' delete por acidente ou ataque direto à API.
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // Logins e senhas de portal do cliente (prefeitura, posto fiscal, PIN do
    // certificado, Meu Gov, e-CAC). Id do doc = id do cliente.
    // [2026-11-06] Só pelo servidor: os callables lerCredenciaisCliente /
    // salvarCredenciaisCliente / exportarCredenciaisClientes
    // (functions/src/clientes/credenciais-callables.ts) exigem admin/fiscal
    // (podeVerCredenciais), cifram com CREDENTIAL_KEY e gravam log com IP a
    // cada revelação. Ler direto daqui era ler em massa (2000 docs) sem rastro.
    match /clientes_credenciais/{clienteId} {
      allow read, write: if false;
    }

    match /clientes_servicos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantWrite();
      allow update: if isOperacional() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Cliente 360: POP, notas internas e comentários ───────────────────────
    // [P0-B] Três coleções em uso pelo app (clientes/[id]/page-client.tsx) que não
    // tinham regra nenhuma. O Firestore nega por padrão o que não está declarado,
    // então as abas POP, Notas internas e Comentários da timeline morreriam com
    // permission-denied no primeiro dia.
    //
    // NOTA DE ISOLAMENTO: nenhuma delas está em TENANT_SCOPED_COLLECTIONS
    // (src/lib/firestore-client.ts), então `listDocuments` NÃO injeta
    // `where('tenantId','==',...)` na query — exigir tenantId no `list` derrubaria
    // a query inteira, não filtraria nada. Vale o mesmo raciocínio já documentado
    // em `usuarios`: o ambiente é single-tenant por deploy. O `get` continua
    // conferindo tenant e a escrita grava tenantId (withActorMetadata preenche).
    // Assim que essas coleções entrarem em TENANT_SCOPED_COLLECTIONS, trocar o
    // `list` por `canRead() && sameTenantExisting()`.

    match /clientes_pop/{id} {
      allow get: if canRead() && sameTenantExisting();
      allow list: if canRead();
      allow create: if podeColaborarCliente() && sameTenantWrite();
      allow update: if podeColaborarCliente() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // Notas internas do POP: a UI é append-only (textarea que só acrescenta).
    // Reescrever ou apagar histórico fica com o admin, igual tarefas_comentarios.
    match /clientes_pop_notas/{id} {
      allow get: if canRead() && sameTenantExisting();
      allow list: if canRead();
      allow create: if podeColaborarCliente() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /clientes_comentarios/{id} {
      allow get: if canRead() && sameTenantExisting();
      allow list: if canRead();
      allow create: if podeColaborarCliente() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Serviços (tipos cadastrais do escritório) ────────────────────────────

    match /servicos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isAdmin() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Competências ─────────────────────────────────────────────────────────

    match /competencias/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isEquipeContabil() && competenciaPayloadValido() && sameTenantWrite();
      // [MATRIZ DE TRANSIÇÃO] Reabrir concluída/ressuscitar cancelada exige
      // admin (competenciaTransicaoPermitida) — ver auditoria 2026-07-02.
      allow update: if isEquipeContabil() && competenciaPayloadValido() && sameTenantUpdate()
        && competenciaTransicaoPermitida();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Tarefas ──────────────────────────────────────────────────────────────

    match /tarefas/{id} {
      allow read: if canRead() && sameTenantExisting();
      // Equipe contábil (admin/operacional/fiscal) cria e atualiza tarefas (payload validado).
      allow create: if isEquipeContabil() && tarefaPayloadValido() && sameTenantWrite();
      // [MATRIZ DE TRANSIÇÃO] Reabrir concluída/ressuscitar cancelada exige
      // admin ou o responsável atual (tarefaTransicaoPermitida).
      allow update: if isEquipeContabil() && tarefaPayloadValido() && sameTenantUpdate()
        && tarefaTransicaoPermitida();
      // [MELHORIA 2] Delete separado: apenas operacional+ pode deletar tarefas.
      allow delete: if isOperacional() && sameTenantExisting();
    }

    match /tarefas_comentarios/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isEquipeContabil() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // [P0-B] Sessões do timer por tarefa (task-timer.tsx → relatório de
    // produtividade). Estava sem regra nenhuma, ou seja: negada por padrão.
    // Mesma NOTA DE ISOLAMENTO das coleções do Cliente 360 acima — tarefas_timers
    // não está em TENANT_SCOPED_COLLECTIONS, a query da tela Produtividade não
    // manda tenantId, e exigir tenantId no `list` derrubaria o relatório inteiro.
    match /tarefas_timers/{id} {
      allow get: if canReadProdutividade() && sameTenantExisting();
      allow list: if canReadProdutividade();
      // Qualquer usuário ativo cronometra a própria tarefa no cockpit Hoje (tela
      // 'hoje' é default de todos os perfis), mas só em nome de si mesmo: sem
      // amarrar usuarioId ao uid, dava para inflar a produtividade de terceiros.
      allow create: if isAtivo() && sameTenantNew()
        && ('usuarioId' in request.resource.data)
        && request.resource.data.usuarioId == request.auth.uid;
      // Registro de tempo é fato consumado: não se edita depois de gravado.
      allow update: if false;
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Declarações de IR ────────────────────────────────────────────────────

    match /ir_declaracoes/{id} {
      // [P0-1/P1] Leitura restrita a admin/fiscal (perfil) OU quem tem a tela 'ir'
      // concedida via override (hasTela) — tela 'ir' em PERFIL_DEFAULT_TELAS não é
      // liberada por padrão para operacional/financeiro/leitura.
      allow read: if canReadIr() && sameTenantExisting();
      allow create: if isEquipeContabil() && sameTenantWrite();
      allow update: if isEquipeContabil() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /ir_checklist/{id} {
      // [P1] Mesma coleção-irmã de ir_declaracoes — mesma gate de leitura.
      allow read: if canReadIr() && sameTenantExisting();
      allow create: if isEquipeContabil() && sameTenantWrite();
      allow update: if isEquipeContabil() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Financeiro ───────────────────────────────────────────────────────────

    match /lancamentos/{id} {
      // [P0-1/P1] Leitura restrita a admin/financeiro (perfil) OU quem tem a tela
      // 'financeiro' concedida via override (hasTela) — não liberada por padrão
      // para operacional/fiscal/leitura.
      allow read: if canReadFinanceiro() && sameTenantExisting();
      allow create: if isFinanceiro() && sameTenantWrite();
      allow update: if isFinanceiro() && sameTenantUpdate();
      // [MELHORIA 2] Lançamentos financeiros só podem ser deletados por admin —
      // garante rastreabilidade e evita fraude por deleção direta.
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /cobrancas/{id} {
      allow read: if isFinanceiro() && sameTenantExisting();
      allow create: if isFinanceiro() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Fechamento mensal ────────────────────────────────────────────────────

    match /fechamentos/{id} {
      // [P0-1/P1] Leitura restrita a admin/operacional/fiscal (perfil) OU quem tem
      // a tela 'fechamento' concedida via override (hasTela) — não liberada por
      // padrão para financeiro/leitura.
      allow read: if canReadFechamento() && sameTenantExisting();
      allow create: if isEquipeContabil() && sameTenantWrite();
      // [P1] Enforcement server-side da trava mensal: espelha o check client-side
      // em updateFechamentoField — nega update se o mês (ano/mes do próprio doc)
      // tiver uma revisão travada em fechamento_revisoes. Reabrir o mês (admin,
      // via fechamento_revisoes.update) libera este update novamente.
      allow update: if isEquipeContabil() && sameTenantUpdate() && !mesFechamentoTravado();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /fechamento_revisoes/{id} {
      // [P1] Mesma gate de leitura de fechamentos (mesma tela 'fechamento').
      allow read: if canReadFechamento() && sameTenantExisting();
      // [P1] Encerrar revisão (grava travado:true, ou cria a 1ª revisão do mês —
      // sempre travado:true em salvarRevisao) fica liberado para quem já revisa o
      // fechamento (operacional/fiscal — a tela 'fechamento' inclui fiscal em
      // PERFIL_DEFAULT_TELAS, e o create anterior só permitia operacional, o que
      // quebrava "Encerrar revisão" para fiscal). Reabrir o mês (travado:false)
      // exige admin — é a única forma de destravar fechamentos.update acima.
      allow create: if (isOperacional() || isFiscal()) && sameTenantWrite();
      allow update: if sameTenantUpdate()
        && (revisaoReabrindo() ? isAdmin() : (isOperacional() || isFiscal()));
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Fiscal — configuração ────────────────────────────────────────────────

    match /clientes_fiscal/{id} {
      // [P1] Leitura restrita a admin/fiscal (perfil) OU quem tem a tela 'fiscal'
      // concedida via override — dado fiscal sensível, hoje legível por qualquer
      // ativo (inclusive 'leitura') via canRead().
      allow read: if canReadFiscalConfig() && sameTenantExisting();
      // [P0-A] O navegador escreve só a configuração declarativa (município,
      // regime, alíquota, provedor). Credenciais e IDs da Spedy são território
      // exclusivo das Cloud Functions — ver camposFiscalDoServidor().
      allow create: if isFiscal() && sameTenantWrite() && fiscalCreateSemCampoDeServidor();
      allow update: if isFiscal() && sameTenantUpdate() && fiscalUpdateSemCampoDeServidor();
      // Configuração fiscal nunca deve ser deletada sem supervisão admin.
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /fiscal_conectores/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isAdmin() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // Contador da numeração da DPS (Ambiente Nacional) por prestador +
    // ambiente + série — só a Cloud Function (Admin SDK) lê e grava, dentro da
    // transação da emissão. Se o navegador pudesse mexer, voltar o contador
    // repetiria nDPS (DPS duplicada) e adiantá-lo queimaria a numeração.
    match /dps_sequencias/{id} {
      allow read, write: if false;
    }

    // Sem uso (integração da Spedy, encerrada em 2026-09; nenhuma tela nem
    // function lê ou grava). Trancada para não virar depósito de credencial.
    match /clientes_fiscal_integracao/{id} {
      allow read, write: if false;
    }

    // Catálogo de produtos (NF-e/NFC-e): ficha fiscal por produto, preenchida
    // pelo contador. Mesmo gate de dado fiscal (tela 'fiscal').
    match /produtos/{id} {
      allow read: if canReadFiscalConfig() && sameTenantExisting();
      allow create: if isFiscal() && sameTenantWrite();
      allow update: if isFiscal() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── NFS-e ────────────────────────────────────────────────────────────────

    match /nfse_rascunhos/{id} {
      // [P0-1] Leitura restrita a admin/fiscal/financeiro (ver canReadNfse()).
      allow read: if canReadNfse() && sameTenantExisting();
      allow create: if isFiscal() && sameTenantWrite();
      allow update: if isFiscal() && sameTenantUpdate();
      // Rascunhos podem ser deletados pelo fiscal (limpeza de rascunhos antigos).
      allow delete: if isFiscal() && sameTenantExisting();
    }

    // nfse_emitidas: NUNCA escrita direta do browser — apenas Admin SDK via Cloud Functions.
    match /nfse_emitidas/{id} {
      // [P0-1] Leitura restrita a admin/fiscal/financeiro (ver canReadNfse()).
      allow read: if canReadNfse() && sameTenantExisting();
      allow write: if false;
    }

    match /nfse_eventos/{id} {
      // [P0-1] Leitura restrita a admin/fiscal/financeiro (ver canReadNfse()).
      allow read: if canReadNfse() && sameTenantExisting();
      // Histórico fiscal da nota (cancelamento, consulta): só as Cloud
      // Functions gravam (functions/src/nfse/ciclo.ts). Nenhuma tela cria.
      allow write: if false;
    }

    // Timeline do cliente. Quase tudo é gravado pelas functions; o navegador
    // cria só dois tipos (fechamento: revisão encerrada/mês reaberto em
    // src/features/fechamento/services.ts; lancamento: cobrança iniciada em
    // src/components/financeiro/fila-cobranca.tsx), sempre em nome próprio e
    // com a hora do servidor — antes qualquer ativo forjava evento de qualquer
    // tipo, com qualquer autor e data.
    function eventoDoNavegadorValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tenantId', 'tipo', 'titulo', 'descricao', 'clienteId', 'origemColecao', 'origemId',
          'actorId', 'actorNome', 'metadata', 'criadoEm', 'atualizadoEm', 'criadoPorId', 'criadoPorNome'])
        && d.criadoPorId == request.auth.uid
        && (!('actorId' in d) || d.actorId == request.auth.uid)
        && d.criadoEm == request.time
        && d.titulo is string && d.titulo.size() <= 300
        && (!('descricao' in d) || (d.descricao is string && d.descricao.size() <= 2000))
        && (!('metadata' in d) || d.metadata is map)
        && ((d.tipo == 'fechamento' && d.origemColecao == 'fechamento_revisoes' && (isOperacional() || isFiscal()))
          || (d.tipo == 'lancamento' && d.origemColecao == 'lancamentos' && isFinanceiro()));
    }

    match /events/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isAtivo() && sameTenantNew() && eventoDoNavegadorValido();
      allow update, delete: if false;
    }

    // nfse_fila_processamento: somente Cloud Functions.
    match /nfse_fila_processamento/{id} {
      allow read: if isFiscal() && sameTenantExisting();
      allow write: if false;
    }

    // nfse_erros: histórico de rejeições/erros de integração. Escrita só via
    // Cloud Functions (Admin SDK); o front apenas lê o erro do próprio tenant.
    match /nfse_erros/{id} {
      // [P0-1] Leitura restrita a admin/fiscal/financeiro (ver canReadNfse()).
      allow read: if canReadNfse() && sameTenantExisting();
      allow write: if false;
    }

    // ─── Carteira de tomadores e contrato de faturamento ──────────────────────
    // A NFS-e sai EM NOME DO CLIENTE: o prestador é o cliente do escritório e o
    // tomador é o cliente DELE. `tomadores` é a carteira de cada prestador e
    // `nfse_recorrentes` é o contrato (quem fatura quem, de quanto, quando).
    //
    // NÃO CONFUNDIR com `clientes_servicos` (acima), que é o honorário do
    // ESCRITÓRIO — a confusão entre as duas é a origem do bug de
    // prestador == tomador.
    //
    // Escrita direta do navegador é OK aqui, ao contrário de clientes_fiscal:
    // nenhuma das duas guarda credencial, só cadastro do tomador e o contrato.
    // O gate segue a tela 'fiscal', que é quem configura emissão; a LEITURA usa
    // canReadNfse() (inclui 'financeiro') porque estes são os mesmos dados que o
    // financeiro já enxerga denormalizados em nfse_emitidas ao conciliar
    // cobrança — restringir aqui não esconderia nada e quebraria a conciliação.

    match /tomadores/{id} {
      allow read: if canReadNfse() && sameTenantExisting();
      allow create: if isFiscal() && tomadorPayloadValido() && sameTenantWrite();
      allow update: if isFiscal() && tomadorPayloadValido() && sameTenantUpdate();
      // Tomador que já saiu em nota emitida não pode sumir do histórico: a
      // inativação normal é `ativo: false` + `deletedAt`. Delete físico exige
      // admin, mesma regra de clientes.
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /nfse_recorrentes/{id} {
      allow read: if canReadNfse() && sameTenantExisting();
      allow create: if isFiscal() && sameTenantWrite()
        && nfseRecorrentePayloadValido() && tomadorDaCarteiraDoPrestador();
      allow update: if isFiscal() && sameTenantUpdate()
        && nfseRecorrentePayloadValido() && tomadorDaCarteiraDoPrestador();
      // Encerrar contrato é `ativo: false` (ou `dataFim`), não apagar: o
      // histórico do que foi faturado precisa continuar explicável.
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── WhatsApp (régua de cobrança) ─────────────────────────────────────────
    // Todas as coleções são escritas exclusivamente pelas Cloud Functions
    // (Admin SDK ignora rules). O front só lê dados do próprio tenant — sem isso
    // a régua de cobrança e o histórico de mensagens falham com permission-denied.

    match /whatsapp_campaign_rules/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow write: if false;
    }

    match /whatsapp_templates/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow write: if false;
    }

    match /whatsapp_messages/{id} {
      allow read: if isFinanceiro() && sameTenantExisting();
      allow write: if false;
    }

    match /whatsapp_jobs/{id} {
      allow read: if isFinanceiro() && sameTenantExisting();
      allow write: if false;
    }

    match /whatsapp_webhook_events/{id} {
      allow read: if isAdmin() && sameTenantExisting();
      allow write: if false;
    }

    // ─── Logs de auditoria — append-only, nunca deletar ──────────────────────

    // [2026-11-06] O CRUD das coleções sensíveis (clientes, clientes_fiscal,
    // clientes_credenciais, lancamentos, usuarios) é auditado por triggers no
    // servidor (functions/src/auditoria/triggers.ts) e os callables gravam o
    // próprio log com IP. O que o navegador ainda grava (demais coleções) é só
    // um registro "declarado pelo cliente": em nome próprio (uid e e-mail do
    // token), origem 'client', com a hora do servidor e um conjunto fechado de
    // campos — sem isso dava para gravar log com data retroativa ou com
    // qualquer nome/e-mail.
    function logDoNavegadorValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tenantId', 'usuarioId', 'usuarioNome', 'usuarioEmail', 'entidade', 'entidadeId',
          'acao', 'dadosAntes', 'dadosDepois', 'origem', 'path', 'criadoEm'])
        && d.usuarioId == request.auth.uid
        && d.usuarioEmail == request.auth.token.email
        && d.origem == 'client'
        && d.criadoEm == request.time
        && d.entidade is string && d.entidade.size() <= 100
        && d.acao is string && d.acao.size() <= 100;
    }

    match /logs_auditoria/{id} {
      allow read: if isAdmin() && sameTenantExisting();
      allow create: if isAtivo() && sameTenantNew() && logDoNavegadorValido();
      allow update, delete: if false;
    }

    // ─── Configurações do sistema ─────────────────────────────────────────────

    // Sessão que entrou com segundo fator (TOTP). Claim do ID token, assinada
    // pelo Google — o navegador não forja.
    function sessaoComSegundoFator() {
      return ('firebase' in request.auth.token)
        && ('sign_in_second_factor' in request.auth.token.firebase)
        && request.auth.token.firebase.sign_in_second_factor is string;
    }

    match /configuracoes/{id} {
      allow read: if canRead() && sameTenantExisting();
      // configuracoes/seguranca (interruptor mfaObrigatorio): só admin que
      // entrou com 2º fator liga ou desliga — quem liga prova que o TOTP
      // funciona no projeto, e uma senha de admin vazada não desliga a exigência.
      allow create: if isAdmin() && sameTenantNew() && (id != 'seguranca' || sessaoComSegundoFator());
      allow update: if isAdmin() && sameTenantUpdate() && (id != 'seguranca' || sessaoComSegundoFator());
      allow delete: if isAdmin() && sameTenantExisting() && id != 'seguranca';
    }

    // KPIs do Painel (escritos só pelo servidor: functions/src/dashboard.ts).
    // [2026-11-06] Os financeiros (somas/contagens de recebíveis) saíram de
    // dashboard_kpis para dashboard_kpis_financeiro: dashboard_kpis é legível
    // por todo perfil ativo, enquanto lancamentos é negado a operacional,
    // fiscal e leitura — o Painel mostrava a eles o total a receber e em atraso.
    match /dashboard_kpis/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow write: if false;
    }

    match /dashboard_kpis_financeiro/{id} {
      allow read: if canReadFinanceiro() && sameTenantExisting();
      allow write: if false;
    }

    // ─── Documentos (referências de arquivos no Storage) ─────────────────────

    match /documentos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantWrite();
      allow update: if isOperacional() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }
  }
}
