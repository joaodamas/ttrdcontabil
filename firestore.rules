rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ───────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function userExists() {
      return isAuth() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userHasTenant() {
      return userExists()
        && ('tenantId' in userDoc())
        && (userDoc().tenantId is string)
        && userDoc().tenantId.size() > 0;
    }

    // Usuário existe no sistema, está ativo e pertence ao ambiente atual.
    function isAtivo() {
      return userHasTenant()
        && (!('ativo' in userDoc()) || userDoc().ativo == true);
    }

    // Helpers de perfil — hierarquia: admin > operacional/fiscal/financeiro > leitura
    function isAdmin()       { return isAtivo() && userDoc().perfil == 'admin'; }
    function isOperacional() { return isAtivo() && userDoc().perfil in ['admin', 'operacional']; }
    function isFiscal()      { return isAtivo() && userDoc().perfil in ['admin', 'fiscal']; }
    function isFinanceiro()  { return isAtivo() && userDoc().perfil in ['admin', 'financeiro']; }
    function canRead()       { return isAtivo(); }

    function sameTenantExisting() {
      return isAtivo()
        && ('tenantId' in resource.data)
        && resource.data.tenantId == userDoc().tenantId;
    }

    function sameTenantNew() {
      return isAtivo()
        && ('tenantId' in request.resource.data)
        && request.resource.data.tenantId == userDoc().tenantId;
    }

    function sameTenantWrite() {
      return sameTenantNew();
    }

    function sameTenantUpdate() {
      return sameTenantExisting() && sameTenantNew();
    }

    // ─── Validadores de payload ───────────────────────────────────────────────

    function clienteStatusValido(status) {
      return status in ['ativo', 'inativo', 'suspenso'];
    }

    function prioridadeTarefaValida(prioridade) {
      return prioridade in ['baixa', 'normal', 'alta', 'urgente'];
    }

    function statusTarefaValido(status) {
      return status in ['pendente', 'em_andamento', 'concluida', 'cancelada'];
    }

    function clientePayloadValido() {
      return ('status' in request.resource.data)
        && clienteStatusValido(request.resource.data.status)
        && ('razaoSocial' in request.resource.data)
        && (request.resource.data.razaoSocial is string)
        && (request.resource.data.razaoSocial.size() > 0)
        && (request.resource.data.razaoSocial.size() <= 200);
    }

    // [MELHORIA 1] Payload de tarefas agora exige campo 'titulo' — bloqueia
    // criação de tarefas sem título diretamente via API/SDK.
    function tarefaPayloadValido() {
      return ('titulo' in request.resource.data)
        && (request.resource.data.titulo is string)
        && (request.resource.data.titulo.size() > 0)
        && (request.resource.data.titulo.size() <= 500)
        && ('prioridade' in request.resource.data)
        && prioridadeTarefaValida(request.resource.data.prioridade)
        && ('status' in request.resource.data)
        && statusTarefaValido(request.resource.data.status);
    }

    // ─── Usuários ─────────────────────────────────────────────────────────────

    match /usuarios/{uid} {
      allow get: if (isAuth() && request.auth.uid == uid) || (canRead() && sameTenantExisting());
      // NOTA DE ISOLAMENTO: regras de `list` não conseguem filtrar por `tenantId`
      // (não há acesso ao `where` da query). O isolamento aqui depende de dois
      // fatos: (1) o ambiente é SINGLE-TENANT por deploy — `requireEnvironmentTenant`
      // (functions/src/tenant.ts) rejeita qualquer tenant != DEFAULT_TENANT_ID, então
      // todo doc em `usuarios` compartilha o mesmo tenant; (2) o helper de cliente
      // `listDocuments` (src/lib/firestore-client.ts) sempre adiciona
      // `where('tenantId','==', actor.tenantId)`. Num cenário futuro de banco
      // compartilhado entre tenants, trocar por leitura por-doc/denormalização.
      allow list: if canRead();
      allow update: if (isAuth() && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['perfil', 'ativo', 'criadoEm', 'tenantId']))
        || (isAdmin() && sameTenantUpdate());
      allow create: if isAdmin() && sameTenantNew();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Clientes ─────────────────────────────────────────────────────────────

    match /clientes/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && clientePayloadValido() && sameTenantWrite();
      allow update: if isOperacional() && clientePayloadValido() && sameTenantUpdate();
      // [MELHORIA 2] Delete separado: apenas admin pode remover clientes.
      // isOperacional inclui admin, mas tornar explícito evita que um
      // 'operacional' delete por acidente ou ataque direto à API.
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /clientes_servicos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantWrite();
      allow update: if isOperacional() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Serviços (tipos cadastrais do escritório) ────────────────────────────

    match /servicos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isAdmin() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Competências ─────────────────────────────────────────────────────────

    match /competencias/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantWrite();
      allow update: if isOperacional() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Tarefas ──────────────────────────────────────────────────────────────

    match /tarefas/{id} {
      allow read: if canRead() && sameTenantExisting();
      // Todos os ativos podem criar e atualizar tarefas (payload validado).
      allow create: if isOperacional() && tarefaPayloadValido() && sameTenantWrite();
      allow update: if isOperacional() && tarefaPayloadValido() && sameTenantUpdate();
      // [MELHORIA 2] Delete separado: apenas operacional+ pode deletar tarefas.
      allow delete: if isOperacional() && sameTenantExisting();
    }

    match /tarefas_comentarios/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Declarações de IR ────────────────────────────────────────────────────

    match /ir_declaracoes/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantWrite();
      allow update: if isOperacional() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /ir_checklist/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantWrite();
      allow update: if isOperacional() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Financeiro ───────────────────────────────────────────────────────────

    match /lancamentos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isFinanceiro() && sameTenantWrite();
      allow update: if isFinanceiro() && sameTenantUpdate();
      // [MELHORIA 2] Lançamentos financeiros só podem ser deletados por admin —
      // garante rastreabilidade e evita fraude por deleção direta.
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /cobrancas/{id} {
      allow read: if isFinanceiro() && sameTenantExisting();
      allow create: if isFinanceiro() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Fechamento mensal ────────────────────────────────────────────────────

    match /fechamentos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantWrite();
      allow update: if isOperacional() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /fechamento_revisoes/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantWrite();
      allow update: if isOperacional() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── Fiscal — configuração ────────────────────────────────────────────────

    match /clientes_fiscal/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isFiscal() && sameTenantWrite();
      allow update: if isFiscal() && sameTenantUpdate();
      // Configuração fiscal nunca deve ser deletada sem supervisão admin.
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /fiscal_conectores/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isAdmin() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /clientes_fiscal_integracao/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isFiscal() && sameTenantWrite();
      allow update: if isFiscal() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    // ─── NFS-e ────────────────────────────────────────────────────────────────

    match /nfse_rascunhos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isFiscal() && sameTenantWrite();
      allow update: if isFiscal() && sameTenantUpdate();
      // Rascunhos podem ser deletados pelo fiscal (limpeza de rascunhos antigos).
      allow delete: if isFiscal() && sameTenantExisting();
    }

    // nfse_emitidas: NUNCA escrita direta do browser — apenas Admin SDK via Cloud Functions.
    match /nfse_emitidas/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow write: if false;
    }

    match /nfse_eventos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isFiscal() && sameTenantNew();
      allow update, delete: if false;
    }

    match /events/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isAtivo() && sameTenantNew();
      allow update, delete: if false;
    }

    // nfse_fila_processamento: somente Cloud Functions.
    match /nfse_fila_processamento/{id} {
      allow read: if isFiscal() && sameTenantExisting();
      allow write: if false;
    }

    // nfse_erros: histórico de rejeições/erros de integração. Escrita só via
    // Cloud Functions (Admin SDK); o front apenas lê o erro do próprio tenant.
    match /nfse_erros/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow write: if false;
    }

    // ─── WhatsApp (régua de cobrança) ─────────────────────────────────────────
    // Todas as coleções são escritas exclusivamente pelas Cloud Functions
    // (Admin SDK ignora rules). O front só lê dados do próprio tenant — sem isso
    // a régua de cobrança e o histórico de mensagens falham com permission-denied.

    match /whatsapp_campaign_rules/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow write: if false;
    }

    match /whatsapp_templates/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow write: if false;
    }

    match /whatsapp_messages/{id} {
      allow read: if isFinanceiro() && sameTenantExisting();
      allow write: if false;
    }

    match /whatsapp_jobs/{id} {
      allow read: if isFinanceiro() && sameTenantExisting();
      allow write: if false;
    }

    match /whatsapp_webhook_events/{id} {
      allow read: if isAdmin() && sameTenantExisting();
      allow write: if false;
    }

    // ─── Logs de auditoria — append-only, nunca deletar ──────────────────────

    match /logs_auditoria/{id} {
      allow read: if isAdmin() && sameTenantExisting();
      allow create: if isAtivo() && sameTenantNew();
      allow update, delete: if false;
    }

    // ─── Configurações do sistema ─────────────────────────────────────────────

    match /configuracoes/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isAdmin() && sameTenantNew();
      allow update: if isAdmin() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }

    match /dashboard_kpis/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow write: if false;
    }

    // ─── Documentos (referências de arquivos no Storage) ─────────────────────

    match /documentos/{id} {
      allow read: if canRead() && sameTenantExisting();
      allow create: if isOperacional() && sameTenantWrite();
      allow update: if isOperacional() && sameTenantUpdate();
      allow delete: if isAdmin() && sameTenantExisting();
    }
  }
}
