rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }

    function isAtivo() {
      // Active if: authenticated AND (document doesn't exist yet OR ativo is not explicitly false)
      // This avoids blocking users whose document was created without setting ativo:true
      return isAuth() && (
        !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo != false
      );
    }

    match /usuarios/{uid} {
      // Any active user can read the usuarios list (needed for responsável selects in forms)
      allow read: if isAtivo();
      // Own document: only allow updating safe fields — never perfil/ativo (prevents self-promotion)
      allow update: if isAuth() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['perfil', 'ativo']);
      // Admin can write any field
      allow write: if isAdmin();
    }

    match /clientes/{id}         { allow read, write: if isAtivo(); }
    match /clientes_servicos/{id}{ allow read, write: if isAtivo(); }
    match /clientes_fiscal/{id}  { allow read, write: if isAtivo(); }
    match /servicos/{id}         { allow read, write: if isAtivo(); }
    match /competencias/{id}     { allow read, write: if isAtivo(); }
    match /fechamentos/{id}      { allow read, write: if isAtivo(); }
    match /lancamentos/{id}      { allow read, write: if isAtivo(); }
    match /tarefas/{id}          { allow read, write: if isAtivo(); }
    match /tarefa_comentarios/{id}{ allow read, write: if isAtivo(); }
    match /ir_declaracoes/{id}   { allow read, write: if isAtivo(); }
    match /ir_checklist/{id}     { allow read, write: if isAtivo(); }
    match /nfse_rascunhos/{id}   { allow read, write: if isAtivo(); }
    match /nfse_emitidas/{id}    { allow read, write: if isAtivo(); }
    match /nfse_eventos/{id}     { allow read: if isAtivo(); allow create: if isAtivo(); }
    match /nfse_fila_processamento/{id}{ allow read, write: if isAtivo(); }
    match /fiscal_conectores/{id}{ allow read: if isAtivo(); allow write: if isAdmin(); }
  }
}
